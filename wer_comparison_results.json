  "quantisation": {
    "scheme": "onnxruntime quantize_dynamic, weight_type=QInt8, per_channel=True, op_types_to_quantize=['MatMul'] only",
    "why_matmul_only": "The upstream all-ops int8 export emits 54 ConvInteger nodes, and this onnxruntime CPU build has no kernel for them, so that 131 MB file cannot be loaded at all. Restricting quantisation to MatMul leaves the conv subsampling front-end in FP32, producing 0 ConvInteger and 154 MatMulInteger nodes - a graph that loads.",
    "why_not_weight_only": "Weight-only INT8 (dequantise-before-compute) shrinks the file but leaves weights FP32-sized in memory once loaded, so it does not help a RAM-constrained device tier. MatMul-only dynamic INT8 reduces file, RAM and time together.",
    "result": "178.0 MB self-contained per language, versus 459.8 MB FP32 and 2381 MB for the shared multilingual model."
  }
